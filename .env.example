# ─────────────────────────────────────────────────────────────────────────────
# VIMAL EYE HOSPITAL — ENVIRONMENT VARIABLES
# Copy this file to .env for local development.
# Set ALL variables in the Vercel Dashboard for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Resend Email Service (REQUIRED) ──────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=YOUR_RESEND_API_KEY

# ── Hospital Contact (REQUIRED) ───────────────────────────────────────────────
HOSPITAL_EMAIL=pradhumanmali2@gmail.com

# ── Sender Name/Address (Optional — defaults to onboarding@resend.dev) ────────
# Use a verified custom domain sender in production for best deliverability
SENDER_EMAIL=Vimal Eye Hospital <onboarding@resend.dev>

# ── Telegram Group Notifications (REQUIRED) ──────────────────────────────────
# Telegram Bot Token and Hospital Group Chat ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=-1003940188181

